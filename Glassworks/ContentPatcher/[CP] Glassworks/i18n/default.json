	//Artificer

	"Glassworks_Artificer_Name": "Artificer",
	"Glassworks_Artificer_Description": "A machine that creates hilts from metal bars and replica weapons from handles and blades",
	"Glassworks.InvalidSword": "Replica Weapons require a blade, a handle, solar essence and void essence",
	"Glassworks.InvalidGildedIridiumHilt": "Gilded iridium hilts require an iridium hilt, solar essence and a gold bar",
	"Glassworks.InvalidGildedIronHilt": "Gilded iron hilts require an iron hilt, solar essence and a gold bar",
	"Glassworks_Artificer_Fuel": "The Artificer requires solar essence for fuel",
	"Glassworks_Artificer_WrongIngredient": "Use a metal bar to make a handle, a hilt and a gold bar to gild a hilt or a blade to create a replica sword",

	//Kiln

	"Glassworks_Kiln_Name": "Kiln",
	"Glassworks_Kiln_Description": "A machine that creates glass art or glass blades from glass shards and most non-gem minerals",
	"Glassworks_Kiln_Fuel": "The kiln requires 5 glass shards",
	"Glassworks_Kiln_WrongIngredient": "Use two of the same vaild non-gem, non-stone mineral to make a glass blade or one to make a piece of glass art",

	//Artisan Kiln

	"Glassworks_Deluxe_Kiln_Name": "Artisan Kiln",
